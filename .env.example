# ─────────────────────────────────────────────────────────────────────────────
# Innergiz Consulting — environment variables (SAMPLE)
#
# Copy this file to `.env.local` for local dev, and set the real values in your
# host's environment (Hostinger) for production. Do NOT commit `.env.local`.
# The agency fills in real values — the entries below are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── Active (used by the site today) ─────────────────────────────────────────
# Production origin for absolute URLs (sitemap.xml, Open Graph, canonical links).
# No trailing slash. If unset, the code falls back to a harmless placeholder.
NEXT_PUBLIC_SITE_URL="https://www.innergiz.com"


# ── Phase 3: contact form delivery (NOT wired yet — see PROJECT-STATUS.md) ────
# The contact API (app/api/contact/route.ts) is currently a mock and ignores
# these. They are listed so the agency knows what Phase 3 will need:
#   planned flow: contact form → Odoo CRM lead + email notification.

# Email notification provider (e.g. Resend). Leave blank until Phase 3.
# RESEND_API_KEY=""
# Where contact-form notifications are sent:
# CONTACT_NOTIFY_TO="connect@innergiz.com"

# Odoo CRM lead sync (host + API credentials). Leave blank until Phase 3.
# ODOO_BASE_URL=""
# ODOO_DB=""
# ODOO_API_KEY=""
